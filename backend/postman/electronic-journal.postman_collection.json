                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Поиск вернул хотя бы один предмет', function () {",
                  "    pm.expect(json.items.length).to.be.at.least(1);",
                  "});",
                  "pm.test('Все найденные содержат «мат»', function () {",
                  "    json.items.forEach(function (i) {",
