        {
          "name": "Список предметов",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Ответ содержит items, total, page, limit, pages', function () {",
                  "    pm.expect(json).to.have.all.keys('items', 'total', 'page', 'limit', 'pages');",
                  "});",
                  "pm.test('В базе не менее 7 предметов', function () {",
                  "    pm.expect(json.total).to.be.at.least(7);",
                  "});",
                  "pm.test('items — массив', function () {",
                  "    pm.expect(json.items).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/subjects", "host": ["{{baseUrl}}"], "path": ["subjects"] }
          }
        },
